{
  "name": "bel-cybernoc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "electron .",
    "desktop:package": "electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.2.6",
    "@fontsource/rajdhani": "5.2.6",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "com.bel.cybernoc",
    "productName": "BEL CyberNOC",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend"
      },
      {
        "from": "backend-dist/CyberNOCBackend",
        "to": "backend"
      },
      {
        "from": "public/bel.ico",
        "to": "bel.ico"
      },
      {
        "from": "config/monitors.example.json",
        "to": "monitors.example.json"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "LICENSE-COMMERCIAL.md",
        "to": "LICENSE-COMMERCIAL.md"
      },
      {
        "from": "build/watchdog.vbs",
        "to": "watchdog.vbs"
      },
      {
        "from": "public/down-default-alert.mp3",
        "to": "audio-defaults/down-default-alert.mp3"
      },
      {
        "from": "public/restored-default-alert.mp3",
        "to": "audio-defaults/restored-default-alert.mp3"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "shortcutName": "BEL CyberNOC",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
